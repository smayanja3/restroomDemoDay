<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Got2Go</title>
</head>

<body>
    <header>
        <a href="/" id="logo">Got2Go</a>

        <nav id="topNav">
            <a href="/restrooms/map">Map</a>
            <a href="/restrooms">Browse</a>
            <a href="/login" class="buttonS">Log In</a>
            <a href="/signup" class="buttonP">Sign Up</a>
        </nav>
    </header>
    <main>

        <section id="heroContainer">
            <div class="heroText">
                <h1>Find a clean restroom, fast.</h1>
                <p>A free, community-updated map of public restrooms near YOU.</p>
                <div class="heroButtons">
                    <a href="/restrooms/map" class="buttonP">Find a restroom</a>
                    <a href="/restrooms" class="buttonS">Browse the list</a>
                </div>
                <!-- <p>Now covering Boston, Newton, Waltham and Burlington</p> -->
            </div>

            <!-- setting up mini map on landing page wih zoomed in google maps -->
            <div class="mapSide">
                <div class="mapMini">
                    <gmp-map center="42.3601,-71.0589" zoom="15" map-id="DEMO_MAP_ID"></gmp-map>
                </div>
                <a href="/restrooms/map" class="buttonS">Open the full map →</a>
            </div>
        </section>

        <section class="how">
            <div class="howContainer">
                <h2 id="howTitle"> How it works.</h2>
                <ol class="steps">
                    <li class="step">
                        <h3>Find one nearby</h3>
                        <p>Open the map and drag around to see restrooms near you</p>
                    </li>

                    <li class="step">
                        <h3>Check the details</h3>
                        <p>Hours, wheather it's free, and baby changing tables, added by people like you.</p>
                    </li>

                    <li class="step">
                        <h3>Rate it and save it</h3>
                        <p>Leave a quick rating and keep your favorites tap away.</p>
                    </li>
                </ol>
            </div>
        </section>
    </main>

    <footer>
        <div>Restroom location from Refuge Restrooms.</div>
    </footer>

    <nav id="bottomNav">
        <a href="/">Home</a>
        <a href="/restrooms/map">Map</a>
        <a href="/restrooms">Browse</a>
    </nav>
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= apiKey %>&libraries=maps,marker" defer></script>
    <script src="/js/map.js" defer></script>
</body>

</html>