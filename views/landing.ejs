<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Got2Go</title>
</head>

<body>
    <header>
        <a href="/" class="logo">Got2Go</a>

        <nav id="topNav">
            <a href="/restrooms/map">Map</a>
            <a href="/restrooms">Browse</a>
            <a href="/login">Log In</a>
            <a href="/signup">Sign Up</a>
        </nav>
    </header>
    <main>

        <section class="heroContainer">
            <div class="">
                <h1>Find a clean restroom, fast.</h1>
                <p>A free, community-updated map of public restrooms near YOU.</p>
                <div class="">
                    <a href="/restrooms/map">Find a restroom</a>
                    <a href="/restrooms">Browse the list</a>
                </div>
                <p>Now covering Boston, Newton, Waltham and Burlington</p>
            </div>
            <!-- setting up mini map on landing page wih zoomed in google maps -->

            <a href="/restrooms/map" class="mapMini" aria-label="Open the restroom map">
                <span class="street street1"></span>
                <span class="street street2"></span>
                <span class="street street3"></span>
                <span class="pin pin1"></span>
                <span class="pin pin2"></span>
                <span class="pin pin3"></span>
                <span class="mapMiniLabel">Open the map →</span>
            </a>
        </section>

        <section class="how">
            <div clas="howContainer">
                <h2 id="howTitle"> How it works.</h2>
                <ol class="steps">
                    <li class="step">
                        <h3>Find one nearby</h3>
                        <p>Open the map and drag around to see restrooms near you</p>
                    </li>

                    <li class="step">
                        <h3>Check the details</h3>
                        <p>Hours, wheather it's free, and baby changing tables, added by people like you.</p>
                    </li>

                    <li class="step">
                        <h3>Rate it and save it</h3>
                        <p>Leave a quick rating and keep your favorites tap away.</p>
                    </li>
                </ol>
            </div>
        </section>
    </main>

    <footer>
        <div>Restroom location from Refuge Restrooms.</div>
    </footer>

    <nav id="bottomNav">
        <a href="/">Home</a>
        <a href="/restrooms/map">Map</a>
        <a href="/restrooms">Browse</a>
    </nav>

</body>

</html>