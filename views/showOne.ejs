<%- include('partials/head', { title: 'Got2Go: find a clean restroom, fast' }) %>
    <%- include('partials/nav') %>
    <main>
        <h1>
            <%= restroom.name %>
        </h1>
        <p>Address: <%= restroom.address %>
        </p>
        <a href="<%= restroom.mapsUrl %>" target="_blank">Get directions</a>
        <p>Free: <%= restroom.isFree ? 'Yes' : 'No' %>
        </p>
        <p>Hours: <%= restroom.is24Hours ? 'Open 24 hours' : restroom.hours %>
        </p>
    <!-- photos gallery -->
     <section>
        <h2>Photos</h2>

       <% if(photos.length === 0){ %>
            <p>No photos yet. Add one with your review!</p>
       <% } else { %>
            <ul>
                <% photos.forEach( photo => { %>
                    <li>
                        <img src="<%= photo.image %>" alt="Photo of <%= restroom.name %>">
                        <!-- give photo credits maybe -->
                    </li>
               <% }) %>
            </ul>
        <% } %>
     </section>


    <!-- add a review -->
    <section>
         <h2>Add a Review</h2>
         <% if (user) { %>
        <form action="/review/createReview/<%= restroom._id %>" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="review" class="form-label">Your review</label>
                <input type="text" class="form-control" id="review" name="review" required>
            </div>

            <div>
              <label for="rating" class="form-label">Rating</label>
                    <select name="rating" id="rating">
                        <option value="">Choose a rating</option>
                        <option value="5">5 Excellent</option>
                        <option value="4">4 Good</option>
                        <option value="3">3 Okay</option>
                        <option value="2">2 Poor</option>
                        <option value="1">1 Avoid</option>
                    </select>
            </div>

             <div class="mb-3">
                <label for="imageUpload" class="form-label">Photo (optional)</label>
                <input type="file" class="form-control" id="imageUpload" name="file" accept="image/*">
            </div>
            <button type="submit" class="btn btn-primary">Review</button>
        </form>
  <%  } else{ %>
    <p><a href="/login">Log in</a> to leave a review</p>
    <% } %>
  </section>


    <!-- review card: need to complete next -->
    <section>
        <h2>Reviews</h2>
    
          <%  if(reviews.length === 0){ %>
                <p>No reviews yet. Be the first!</p>
           <% } %>
        <ul>
            <% reviews.forEach(review => { %>
                <li>
                    <!-- shows the user for each review -->
                    <p><%= review.author ? review.author.username : 'A User' %></p>
                    <!-- rating -->
                   <% if(review.rating){ %>
                        <p>Rating: <%= review.rating %> / 5</p>
                   <% } %>

                   <!-- comment -->
                    <p><%= review.review %></p>

                    <!-- image -->
                    <% if(review.image){ %>
                        <img src="<%= review.image %>" alt="Photo of <%= restroom.name %> from a review" width="100">  
                   <% } %>
                   <!-- LIKES: NEED TO ADD LOGIC -->
                    <p>Likes: <%= review.likes %></p>

                    <!-- ONLY author of review can delete review -->
                    <% if(user && review.author?._id.toString() === user._id.toString()){
                        <button type="submit">Delete Review</button>
                   <% } %>

                </li>
           <% }) %>
        </ul>

        <a href="/restrooms/edit/<%= restroom._id %>">Edit</a>
        
    </section>
    </main>
      <%- include('partials/footer') %>
      <script src="/js/main.js"></script>
</body>

</html>