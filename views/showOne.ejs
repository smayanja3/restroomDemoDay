<%- include('partials/head', { title: 'Got2Go: find a clean restroom, fast' }) %>
    <%- include('partials/nav') %>
    <main>
        <h1>
            <%= restroom.name %>
        </h1>
        <p>Adress: <%= restroom.address %>
        </p>
        <a href="<%= restroom.mapsUrl %>" target="_blank">Get directions</a>
        <p>Free: <%= restroom.isFree ? 'Yes' : 'No' %>
        </p>
        <p>Hours: <%= restroom.is24Hours ? 'Open 24 hours' : restroom.hours %>
        </p>
    <!-- add a review -->
    <section>
         <h2>Add a Review</h2>
         <% if (user) { %>
        <form action="/review/createReview/<%= restroom._id %>" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="review" class="form-label">Your review</label>
                <input type="text" class="form-control" id="review" name="review" required>
            </div>

            <div>
              <label for="rating" class="form-label">Rating</label>
                    <select name="rating" id="rating">
                        <option value="">Choose a rating</option>
                        <option value="5">5 Excellent</option>
                        <option value="4">4 Good</option>
                        <option value="3">3 Okay</option>
                        <option value="2">2 Poor</option>
                        <option value="1">1 Avoid</option>
                    </select>
            </div>

             <div class="mb-3">
                <label for="imgUpload" class="form-label">Photo (optional)</label>
                <input type="file" class="form-control" id="imageUpload" name="file" accept="image/*">
            </div>
            <button type="submit" class="btn btn-primary">Review</button>
        </form>
  <%  } else{ %>
    <p><a href="/login">Log in</a>to leave a review</p>
    <% } %>
  </section>


    <!-- review card: need to complete next -->
        <ul>
            <p>Reviews show up here</p>
            <% for(let i = 0; i < reviews.length; i ++) { %>
            <li class="col-6 justify-content-between mt-5">
            <%= reviews[i].review %>
            </li>
        <% } %>
        </ul>
        <a href="/restrooms/edit/<%= restroom._id %>">Edit</a>
        <button type="button" id="danger" data-id="<%= restroom._id %>">Delete</button>
    </main>
      <%- include('partials/footer') %>
</body>
<script src="/js/main.js"></script>

</html>