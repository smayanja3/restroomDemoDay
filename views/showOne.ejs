<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css.style.css">
    <title>
        <%= restroom.name %>
    </title>
</head>

<body>
    <header>
        <h2 class="logo">Got2Go</h2>
        <nav>
            <ul>
                <!-- <li><a href="/profile"> Profile</a></li> -->
                <li><a href="/restrooms">Browse</a></li>
                <li><a href="/restrooms/new">Add a Restroom</a></li>
                <!-- <li><a href="/logout"> Sign Out</a></li> -->
            </ul>
        </nav>
    </header>
    <main>
        <h1>
            <%= restroom.name %>
        </h1>
        <p>Adress: <%= restroom.address %>
        </p>
        <p>Free: <%= restroom.isFree ? 'Yes' : 'No' %>
        </p>
        <p>Hours: <%= restroom.is24Hours ? 'Open 24 hours' : restroom.hours %>
        </p>
        <a href="/restrooms/edit/<%= restroom._id %>">Edit</a>
        <button type="button" id="danger" data-id="<%= restroom._id %>">Delete</button>
        <a href="/restrooms/new">Add another restroom</a>
    </main>
</body>
<script src="/js/main.js"></script>

</html>