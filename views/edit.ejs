<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css.style.css">
    <title>
        <%= restroom.name %>
    </title>
</head>
<header>
        <h2 class="logo">Got2Go</h2>
        <nav>
            <ul>
                <!-- <li><a href="/profile"> Profile</a></li> -->
                <li><a href="">Browse</a></li>
                <li><a href="/restrooms/new">Add a Restroom</a></li>
            </ul>
        </nav>
    </header>

<body>
     <h1>Add a Restroom</h1>

   <form id="editF" data-id="<%= restroom._id %>">

        <p>
            <label for="name">Location Name</label>
            <input type="text" id="name" name="name" value="<%= restroom.name %>" required>
        </p>

        <p>
            <label for="address">Address</label>
            <input type="text" id="address" name="address" value="<%= restroom.address %>" required>
        </p>

        <p>
            <label><input type="checkbox"  id="isFree" name="isFree" <%= restroom.isFree ? 'checked' : '' %>>Free to use</label>
        </p>

        <p>
            <label><input type="checkbox"  id="is24Hours" name="is24Hours" <%= restroom.is24Hours ? 'checked' : '' %>>Open 24 hours</label>
        </p>
        <button type="submit">Save Changes</button>
        <a href="/restrooms/<%= restroom._id %>">Cancel</a>
    </form>
</body>
<script src="/js/main.js"></script>

</html>