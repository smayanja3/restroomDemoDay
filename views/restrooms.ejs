<%- include('partials/head', { title: 'Got2Go: find a clean restroom, fast' }) %>
    <%- include('partials/nav') %>
<main>
    <h1>All Restrooms</h1>

   <% if(restrooms.length === 0) { %>
        <p>No restrooms yet.</p>
   <% } %>

   <ul>
    <% restrooms.forEach(restroom => { %>
         <li>
            <a href="/restrooms/<%= restroom._id %>"><%= restroom.name %></a>
            <%= restroom.address %>
             <%= restroom.isFree ? 'Free' : '' %>
              <%= restroom.is24Hours ? '24 Hours' : '' %>
         </li>
  <%  }) %>
   
   </ul>

</main>
  <%- include('partials/footer') %>
</body>

</html>